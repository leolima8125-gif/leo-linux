# Leo Linux - imagem atômica própria, baseada no Fedora Kinoite (KDE Plasma oficial do Fedora).
# Sem dependência do Bazzite: a camada de jogos (Steam, gamescope, sessões) é do Leo Linux.
# Confira a tag disponível em https://quay.io/repository/fedora/fedora-kinoite
ARG FEDORA_VERSION=45

FROM scratch AS ctx
COPY build_files /build_files

FROM quay.io/fedora/fedora-kinoite:${FEDORA_VERSION}

# Arquivos de sistema do Leo Linux (sessões, scripts, tema padrão, sysctl)
COPY system_files/ /

RUN --mount=type=bind,from=ctx,source=/build_files,target=/ctx \
    bash /ctx/build.sh

LABEL org.opencontainers.image.title="Leo Linux"
LABEL org.opencontainers.image.description="Sistema Linux atômico para jogos, com modo game e desktop KDE"
